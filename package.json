{
  "name": "aero-clean",
  "version": "1.0.0",
  "private": true,
  "description": "AERO CLEAN — vent and air duct cleaning website (Next.js App Router, static export).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:publish": "node scripts/check-publish-readiness.mjs",
    "verify": "npm run lint && npm run build && npm run typecheck"
  },
  "dependencies": {
    "lucide-react": ">=0.460.0 <2.0.0",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
